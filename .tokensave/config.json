{
  "version": 2,
  "root_dir": "/home/gangio/fbclickerai",
  "exclude": [
    "**/target/**",
    "**/.git/**",
    "**/.tokensave/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/*.min.*",
    "**/build/**",
    "**/out/**",
    "**/.gradle/**",
    "**/site-packages/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "bin/**"
  ],
  "include": [],
  "force_include": [],
  "max_file_size": 1048576,
  "extract_docstrings": true,
  "track_call_sites": true,
  "git_ignore": true,
  "default_path_include": [],
  "default_path_exclude": [],
  "source_path_overrides": [],
  "docs_dir": "tokensave-docs",
  "last_indexed_version": "7.14.1",
  "auto_track": false,
  "strict_tree": false,
  "max_auto_sync_files": 2000,
  "report_savings": false,
  "artifact_extensions": [
    "feature",
    "json",
    "yaml",
    "yml",
    "sql",
    "toml",
    "proto",
    "graphql",
    "md",
    "bnd",
    "bndrun"
  ],
  "suppress_scope_warning": false,
  "_comment": "TOKENSAVE_* environment variables override matching config values when set."
}